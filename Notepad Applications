End Sub
Private Sub OpenToolStripMenuItem_Click(ByVal sender As System.Object,
ByVal e As System.EventArgs) Handles OpenToolStripMenuItem.Click
Me.OpenFileDialog1.DefaultExt = "richtextformat/*.rtf"
Me.OpenFileDialog1.Filter = "textfiles|*.txt|all files|*.*"
Me.OpenFileDialog1.ShowDialog()
Me.RichTextBox1.LoadFile(Me.OpenFileDialog1.FileName,
RichTextBoxStreamType.PlainText)
Me.Text = (Me.OpenFileDialog1.FileName)
End Sub
